    {
      "name": "3. Requirements & Matching",
      "description": "",
      "item": [
        {
          "name": "Filter employees (no save)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requirements"
              ],
              "raw": "{{baseUrl}}/api/requirements"
            },
            "description": "No project_name / joining_date / required_skills = filter-only. Nothing saved, no AI. 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department\": \"Engineering\",\n  \"minimum_experience_years\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create requirement + match (sync)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requirements"
              ],
              "raw": "{{baseUrl}}/api/requirements"
            },
            "description": "Saves the requirement and runs matching inline. 201. Stores requirementId, matchingRunId, matchingResultId and employeeId for later requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_name\": \"Odisha Health Portal\",\n  \"project_id\": 1,\n  \"description\": \"Backend developer for REST APIs\",\n  \"required_skills\": [\n    {\n      \"skill_name\": \"Java\",\n      \"mandatory\": true,\n      \"minimum_proficiency\": 4\n    },\n    {\n      \"skill_name\": \"Spring Boot\",\n      \"mandatory\": true,\n      \"minimum_proficiency\": 3\n    },\n    {\n      \"skill_name\": \"MySQL\",\n      \"mandatory\": false,\n      \"minimum_proficiency\": 3\n    }\n  ],\n  \"minimum_experience_years\": 3,\n  \"joining_date\": \"2026-12-01\",\n  \"duration_months\": 6,\n  \"location\": \"Bhubaneswar\",\n  \"work_mode\": \"ONSITE\",\n  \"headcount\": 2,\n  \"priority\": \"HIGH\",\n  \"include_approved_pending\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const j = pm.response.json();",
                  "if (j.requirement_id) pm.collectionVariables.set('requirementId', j.requirement_id);",
                  "if (j.matching_run_id) pm.collectionVariables.set('matchingRunId', j.matching_run_id);",
                  "const m = j.llm_result && j.llm_result.matches && j.llm_result.matches[0];",
                  "if (m && m.matching_result_id) {",
                  "  pm.collectionVariables.set('matchingResultId', m.matching_result_id);",
                  "  pm.collectionVariables.set('employeeId', m.employee_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create requirement + match (async)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requirements"
              ],
              "query": [
                {
                  "key": "async",
                  "value": "true"
                }
              ],
              "raw": "{{baseUrl}}/api/requirements?async=true"
            },
            "description": "202 immediately; poll `Get matching run status` until COMPLETED / COMPLETED_WITH_ERRORS / FAILED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_name\": \"Odisha Health Portal\",\n  \"project_id\": 1,\n  \"description\": \"Backend developer for REST APIs\",\n  \"required_skills\": [\n    {\n      \"skill_name\": \"Java\",\n      \"mandatory\": true,\n      \"minimum_proficiency\": 4\n    },\n    {\n      \"skill_name\": \"Spring Boot\",\n      \"mandatory\": true,\n      \"minimum_proficiency\": 3\n    },\n    {\n      \"skill_name\": \"MySQL\",\n      \"mandatory\": false,\n      \"minimum_proficiency\": 3\n    }\n  ],\n  \"minimum_experience_years\": 3,\n  \"joining_date\": \"2026-12-01\",\n  \"duration_months\": 6,\n  \"location\": \"Bhubaneswar\",\n  \"work_mode\": \"ONSITE\",\n  \"headcount\": 2,\n  \"priority\": \"HIGH\",\n  \"include_approved_pending\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const j = pm.response.json();",
                  "if (j.requirement_id) pm.collectionVariables.set('requirementId', j.requirement_id);",
                  "if (j.matching_run_id) pm.collectionVariables.set('matchingRunId', j.matching_run_id);",
                  "const m = j.llm_result && j.llm_result.matches && j.llm_result.matches[0];",
                  "if (m && m.matching_result_id) {",
                  "  pm.collectionVariables.set('matchingResultId', m.matching_result_id);",
                  "  pm.collectionVariables.set('employeeId', m.employee_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create requirement - validation error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requirements"
              ],
              "raw": "{{baseUrl}}/api/requirements"
            },
            "description": "Expected 400 listing required_skills, minimum_experience_years, joining_date.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_name\": \"Missing fields demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get matching run status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matching-runs",
                "{{matchingRunId}}"
              ],
              "raw": "{{baseUrl}}/api/matching-runs/{{matchingRunId}}"
            },
            "description": "Frontend polls this every 2 seconds after an async request."
          }
        },
        {
          "name": "List requirements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requirements"
              ],
              "raw": "{{baseUrl}}/api/requirements"
            },
            "description": ""
          }
        },
        {
          "name": "Get requirement by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requirements",
                "{{requirementId}}"
              ],
              "raw": "{{baseUrl}}/api/requirements/{{requirementId}}"
            },
            "description": ""
          }
        },
        {
          "name": "Get matches of requirement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requirements",
                "{{requirementId}}",
                "matches"
              ],
              "query": [
                {
                  "key": "runId",
                  "value": "{{matchingRunId}}",
                  "disabled": true
                }
              ],
              "raw": "{{baseUrl}}/api/requirements/{{requirementId}}/matches"
            },
            "description": "Latest finished run by default; enable runId for a specific run."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const j = pm.response.json();",
                  "if (j.length) {",
                  "  pm.collectionVariables.set('matchingResultId', j[0].matching_result_id);",
                  "  pm.collectionVariables.set('employeeId', j[0].employee_id);",
                  "  const l = j[0].learning_suggestions && j[0].learning_suggestions[0];",
                  "  if (l) pm.collectionVariables.set('learningRecommendationId', l.learning_recommendation_id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Shortlist, Decisions & Allocation",
      "description": "",
      "item": [
        {
          "name": "Shortlist match",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matching-results",
                "{{matchingResultId}}",
                "shortlist"
              ],
              "raw": "{{baseUrl}}/api/matching-results/{{matchingResultId}}/shortlist"
            },
            "description": "Sets recommendation_status = RECOMMENDED. No body."
          }
        },
        {
          "name": "Set recommendation status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matching-results",
                "{{matchingResultId}}",
                "recommendation"
              ],
              "raw": "{{baseUrl}}/api/matching-results/{{matchingResultId}}/recommendation"
            },
            "description": "RECOMMENDED | NOT_RECOMMENDED | REVIEW_REQUIRED",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recommendation_status\": \"REVIEW_REQUIRED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create decision (approve)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "decisions"
              ],
              "raw": "{{baseUrl}}/api/decisions"
            },
            "description": "decision: SELECTED | REJECTED | ON_HOLD | DEFERRED | WITHDRAWN. 201. Saves decisionId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matching_result_id\": {{matchingResultId}},\n  \"requirement_id\": {{requirementId}},\n  \"decision\": \"SELECTED\",\n  \"decision_reason\": \"Best fit for backend work\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('decisionId', pm.response.json().allocationDecisionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create decision (hold)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "decisions"
              ],
              "raw": "{{baseUrl}}/api/decisions"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matching_result_id\": {{matchingResultId}},\n  \"requirement_id\": {{requirementId}},\n  \"decision\": \"ON_HOLD\",\n  \"decision_reason\": \"Waiting for client interview\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List decisions of requirement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "decisions"
              ],
              "query": [
                {
                  "key": "requirementId",
                  "value": "{{requirementId}}"
                }
              ],
              "raw": "{{baseUrl}}/api/decisions?requirementId={{requirementId}}"
            },
            "description": ""
          }
        },
        {
          "name": "Confirm allocation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "allocations"
              ],
              "raw": "{{baseUrl}}/api/allocations"
            },
            "description": "decision_id must be a SELECTED decision without an allocation. 201. Saves allocationId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requirement_id\": {{requirementId}},\n  \"employee_id\": {{employeeId}},\n  \"allocation_percentage\": 100,\n  \"start_date\": \"2026-12-01\",\n  \"end_date\": \"2027-05-31\",\n  \"decision_id\": {{decisionId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('allocationId', pm.response.json().allocationId);"
                ]
              }
            }
          ]
        }
      ]
    },
