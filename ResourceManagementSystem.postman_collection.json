{
  "info": {
    "name": "Resource Management System API",
    "description": "AI-Enabled Skill Matching & Resource Allocation.\n\n1. Set `username` / `password` in the collection variables.\n2. Run **Auth > Login** - the token is saved automatically.\n3. Run requests top to bottom; ids (requirementId, matchingRunId, matchingResultId, decisionId, allocationId, ...) are captured by test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ],
              "raw": "{{baseUrl}}/auth/login"
            },
            "description": "Public. Saves the JWT into the `token` collection variable; every other request uses it as Bearer auth.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);",
                  "pm.test('Token received', () => pm.expect(j.token).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Master Data & Employees",
      "description": "",
