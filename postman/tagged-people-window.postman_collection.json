{
  "info": {
    "name": "Tagged people - requirement window",
    "description": "Tagged-people rule evaluated against the requirement window (joining_date .. joining_date + duration_months - 1 day, open-ended without duration_months).\n\nFixtures (employee_id 4): allocation 5 (req 107, 2026-11-02..2026-11-03, 100%), allocation 1 (req 59, from 2026-12-01 open-ended, 100%), pending SELECTED decision 5 (req 102, matching_result 104, allocation_id null).\n\nRun in order. WRITES to the database: every search saves a project_requirement + matching run; 'Withdraw' and 'Restore' each add an allocation_decisions row (restore re-approves, so a NEW pending SELECTED decision replaces id 5 as the latest).\n\nRequired environment: baseUrl, username, password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('empId', 4);",
          "pm.collectionVariables.set('skillsJson', JSON.stringify([",
          "  { skill_name: 'C#', mandatory: true, minimum_proficiency: 1 },",
          "  { skill_name: 'Generative AI', mandatory: false, minimum_proficiency: 1 }",
          "]));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared helpers for the search requests",
          "pm.collectionVariables.set('taggedHelpers', `(${function () {",
          "  const empId = 4;",
          "  const body = pm.response.json();",
          "  const tp = body.tagged_people || {};",
          "  const excluded = (tp.excluded || []).find(e => e.employee_id === empId);",
          "  const matches = ((body.llm_result || {}).matches || []).map(m => m.employee_id);",
          "  const tag = name => excluded && excluded.tags.find(t => t.tag === name);",
          "  const allocIds = () => (tag('FULLY_ALLOCATED') || { allocations: [] }).allocations.map(a => a.allocation_id).sort();",
          "  return { body, tp, excluded, matches, tag, allocIds, empId };",
          "}})()`);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Login",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('login ok', () => pm.response.to.have.status(200));",
          "pm.environment.set('token', pm.response.json().token);"
        ] }
      }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" }
      }
    },
    {
      "name": "1. Search joining 2026-11-02 (open-ended) -> excluded",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "const h = eval(pm.collectionVariables.get('taggedHelpers'));",
          "pm.test('201 saved + matched', () => pm.response.to.have.status(201));",
          "pm.test('window is 2026-11-02 .. open', () => {",
          "  pm.expect(h.tp.window.from).to.eql('2026-11-02');",
          "  pm.expect(h.tp.window.to).to.eql(null);",
          "});",
          "pm.test('employee 4 is excluded from the pool', () => {",
          "  pm.expect(h.excluded, 'employee 4 in tagged_people.excluded').to.exist;",
          "  pm.expect(h.matches).to.not.include(h.empId);",
          "});",
          "pm.test('FULLY_ALLOCATED by allocations 1 and 5 (both overlap the open window)', () => {",
          "  pm.expect(h.tag('FULLY_ALLOCATED')).to.exist;",
          "  pm.expect(h.allocIds()).to.eql([1, 5]);",
          "  pm.expect(h.excluded.window_free_percentage).to.eql(0);",
          "});",
          "pm.test('APPROVED_PENDING for requirement 102', () => {",
          "  const t = h.tag('APPROVED_PENDING');",
          "  pm.expect(t).to.exist;",
          "  pm.expect(t.requirement_id).to.eql(102);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/requirements",
        "body": { "mode": "raw", "raw": "{\n  \"project_name\": \"Tagged people test 1\",\n  \"required_skills\": {{skillsJson}},\n  \"minimum_experience_years\": 0,\n  \"joining_date\": \"2026-11-02\"\n}" }
      }
    },
    {
      "name": "2. Search joining 2026-12-01 (open-ended) -> excluded",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "const h = eval(pm.collectionVariables.get('taggedHelpers'));",
          "pm.test('201 saved + matched', () => pm.response.to.have.status(201));",
          "pm.test('employee 4 is excluded from the pool', () => {",
          "  pm.expect(h.excluded, 'employee 4 in tagged_people.excluded').to.exist;",
          "  pm.expect(h.matches).to.not.include(h.empId);",
          "});",
          "pm.test('FULLY_ALLOCATED by allocation 1 only (allocation 5 ended 2026-11-03, before joining)', () => {",
          "  pm.expect(h.tag('FULLY_ALLOCATED')).to.exist;",
          "  pm.expect(h.allocIds()).to.eql([1]);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/requirements",
        "body": { "mode": "raw", "raw": "{\n  \"project_name\": \"Tagged people test 2\",\n  \"required_skills\": {{skillsJson}},\n  \"minimum_experience_years\": 0,\n  \"joining_date\": \"2026-12-01\"\n}" }
      }
    },
    {
      "name": "3a. Search joining 2026-11-10 + 1 month, approval pending",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "const h = eval(pm.collectionVariables.get('taggedHelpers'));",
          "pm.test('201 saved + matched', () => pm.response.to.have.status(201));",
          "pm.test('window is 2026-11-10 .. 2026-12-09', () => {",
          "  pm.expect(h.tp.window.from).to.eql('2026-11-10');",
          "  pm.expect(h.tp.window.to).to.eql('2026-12-09');",
          "});",
          "pm.test('employee 4 is excluded', () => {",
          "  pm.expect(h.excluded).to.exist;",
          "  pm.expect(h.matches).to.not.include(h.empId);",
          "});",
          "pm.test('APPROVED_PENDING (decision on requirement 102)', () => {",
          "  pm.expect(h.tag('APPROVED_PENDING')).to.exist;",
          "  pm.expect(h.tag('APPROVED_PENDING').requirement_id).to.eql(102);",
          "});",
          "// Allocation 1 (100% from 2026-12-01) overlaps 2026-12-01..2026-12-09, so the date rule also excludes her.",
          "pm.test('also FULLY_ALLOCATED by allocation 1 (overlaps 12-01..12-09); allocation 5 does not count', () => {",
          "  pm.expect(h.allocIds()).to.eql([1]);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/requirements",
        "body": { "mode": "raw", "raw": "{\n  \"project_name\": \"Tagged people test 3a\",\n  \"required_skills\": {{skillsJson}},\n  \"minimum_experience_years\": 0,\n  \"joining_date\": \"2026-11-10\",\n  \"duration_months\": 1\n}" }
      }
    },
    {
      "name": "3b. Withdraw pending approval (matching_result 104, requirement 102)",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('WITHDRAWN decision created', () => {",
          "  pm.response.to.have.status(201);",
          "  pm.expect(pm.response.json().decision).to.eql('WITHDRAWN');",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/decisions",
        "body": { "mode": "raw", "raw": "{\n  \"matching_result_id\": 104,\n  \"requirement_id\": 102,\n  \"decision\": \"WITHDRAWN\",\n  \"decision_reason\": \"Postman tagged-people test: withdraw pending approval\"\n}" }
      }
    },
    {
      "name": "3c. Search joining 2026-11-10 + 1 month, approval withdrawn",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "const h = eval(pm.collectionVariables.get('taggedHelpers'));",
          "pm.test('201 saved + matched', () => pm.response.to.have.status(201));",
          "pm.test('APPROVED_PENDING is gone after withdrawal', () => {",
          "  pm.expect(h.tag('APPROVED_PENDING')).to.not.exist;",
          "});",
          "// Under the window rule she stays excluded: allocation 1 is 100% from 2026-12-01, inside this window.",
          "pm.test('still excluded, now only by FULLY_ALLOCATED (allocation 1)', () => {",
          "  pm.expect(h.excluded).to.exist;",
          "  pm.expect(h.excluded.tags.map(t => t.tag)).to.eql(['FULLY_ALLOCATED']);",
          "  pm.expect(h.allocIds()).to.eql([1]);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/requirements",
        "body": { "mode": "raw", "raw": "{\n  \"project_name\": \"Tagged people test 3c\",\n  \"required_skills\": {{skillsJson}},\n  \"minimum_experience_years\": 0,\n  \"joining_date\": \"2026-11-10\",\n  \"duration_months\": 1\n}" }
      }
    },
    {
      "name": "3d. Restore: re-approve (SELECTED) so the fixture is pending again",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('SELECTED decision created, allocation_id null', () => {",
          "  pm.response.to.have.status(201);",
          "  const d = pm.response.json();",
          "  pm.expect(d.decision).to.eql('SELECTED');",
          "  pm.expect(d.allocationId).to.eql(null);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/decisions",
        "body": { "mode": "raw", "raw": "{\n  \"matching_result_id\": 104,\n  \"requirement_id\": 102,\n  \"decision\": \"SELECTED\",\n  \"decision_reason\": \"Postman tagged-people test: restore pending approval\"\n}" }
      }
    }
  ]
}
